          <dc:Bounds x="592" y="228.0" width="150" height="56"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_eligible_di" bpmnElement="Order_eligible">
        <dc:Bounds x="895" y="460.0" width="186" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_allowed_di" bpmnElement="Order_allowed">
        <dc:Bounds x="1150" y="476.0" width="54" height="54"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1102" y="538.0" width="150" height="56"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_stop_di" bpmnElement="Order_stop">
        <dc:Bounds x="1405" y="112.0" width="42" height="42"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1357" y="162.0" width="138" height="56"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_checkout_di" bpmnElement="Order_checkout">
        <dc:Bounds x="1405" y="245.0" width="186" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_ready_di" bpmnElement="Order_ready">
        <dc:Bounds x="1660" y="261.0" width="54" height="54"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1612" y="323.0" width="150" height="56"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_exit_di" bpmnElement="Order_exit">
        <dc:Bounds x="1915" y="112.0" width="42" height="42"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1867" y="162.0" width="138" height="56"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_pay_di" bpmnElement="Order_pay">
        <dc:Bounds x="1915" y="460.0" width="186" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_paid_di" bpmnElement="Order_paid">
        <dc:Bounds x="2170" y="476.0" width="54" height="54"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2122" y="538.0" width="150" height="56"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_pending_di" bpmnElement="Order_pending">
        <dc:Bounds x="2425" y="792.0" width="42" height="42"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2377" y="842.0" width="138" height="56"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_fulfil_di" bpmnElement="Order_fulfil">
        <dc:Bounds x="2425" y="460.0" width="186" height="86"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Order_end_di" bpmnElement="Order_end">
        <dc:Bounds x="2680" y="482.0" width="42" height="42"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2632" y="532.0" width="138" height="56"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Order_f0_di" bpmnElement="Order_f0">
        <di:waypoint x="172" y="193.0"/>
        <di:waypoint x="385" y="193.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Order_f1_di" bpmnElement="Order_f1">
        <di:waypoint x="571" y="193.0"/>
        <di:waypoint x="640" y="193.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Order_f2_di" bpmnElement="Order_f2">
        <di:waypoint x="694" y="193.0"/>
        <di:waypoint x="875" y="193.0"/>
        <di:waypoint x="875" y="503.0"/>
        <di:waypoint x="895" y="503.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820.0" y="310.0" width="130" height="38"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Order_f3_di" bpmnElement="Order_f3">
        <di:waypoint x="694" y="193.0"/>
        <di:waypoint x="714" y="193.0"/>
        <di:waypoint x="714" y="99.0"/>
        <di:waypoint x="1895" y="99.0"/>
        <di:waypoint x="1895" y="133.0"/>
        <di:waypoint x="1915" y="133.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1249.5" y="61.0" width="130" height="38"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Order_f4_di" bpmnElement="Order_f4">
        <di:waypoint x="1081" y="503.0"/>
        <di:waypoint x="1150" y="503.0"/>
